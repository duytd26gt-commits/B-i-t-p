public class Ball {
   private float x;
    private float y;
    private int radius;
    private float xDelta;
    private float yDelta;
   public Ball(float x,float y,int r,float xD,float yD){
     this. x = x;
      this.y = y;
       this.radius = r;
       this.xDelta = xD;
       this.yDelta = yD;

   }
   public float getX(){
       return x;
   }
   public void setX(float x){
       this.x = x;
   }
   public float getY(){
       return y;
   }
   public void setY(float y){
       this.y = y;

   }
   public int getRadius (){
       return radius;

   }
   public void setRadius(int r){
       radius = r;
   }
   public float getXDelta(){
       return xDelta;

   }
   public void setXDelta(float xD){
       xDelta = xD;
   }
   public float getYDelta(){
       return yDelta;

   }
   public void setYDelta(float yD){
       yDelta = yD;
   }
   public void move(){
       x += xDelta;
       y += yDelta;

   }
   public void reflectHorizontal(){
       xDelta = -xDelta;

   }
    public void reflectVertical(){
       yDelta = -yDelta;
    }
    public String toString(){
       return "Ball[(" + x + "," + y + "),speed=(" + xDelta + "," + yDelta + ")]";
    }

}
